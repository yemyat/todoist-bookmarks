# Todoist OAuth App Credentials
# Get from: https://developer.todoist.com/appconsole.html
TODOIST_CLIENT_ID=your-client-id
TODOIST_CLIENT_SECRET=your-client-secret

# Todoist Project ID
# Find by opening the project in Todoist web, the URL will be: todoist.com/app/project/PROJECT_ID
TODOIST_PROJECT_ID=your-project-id

# Firecrawl API Key
# Get from: https://firecrawl.dev (sign up for free tier)
FIRECRAWL_API_KEY=your-firecrawl-api-key

# Google AI API Key (for Gemini)
# Get from: https://aistudio.google.com/apikey
GOOGLE_GENERATIVE_AI_API_KEY=your-google-api-key
