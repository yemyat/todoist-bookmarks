# Todoist API Token
# Get from: https://todoist.com/prefs/integrations (scroll to "API token")
TODOIST_API_TOKEN=your-todoist-api-token

# Todoist Client Secret (for webhook verification)
# Get from: https://developer.todoist.com/appconsole.html (your app's Client Secret)
TODOIST_CLIENT_SECRET=your-client-secret

# Todoist Project ID
# Find by opening the project in Todoist web, the URL will be: todoist.com/app/project/PROJECT_ID
TODOIST_PROJECT_ID=your-project-id

# Google AI API Key (for Gemini)
# Get from: https://aistudio.google.com/apikey
GOOGLE_GENERATIVE_AI_API_KEY=your-google-api-key

# Firecrawl API Key
# Get from: https://firecrawl.dev (sign up for free tier)
FIRECRAWL_API_KEY=fc-your-firecrawl-api-key
